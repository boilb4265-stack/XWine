<?xml version="1.0" encoding="utf-8"?>
<!--
  Project XWine — Phase 6 Xbox Developer Mode UWP Package Manifest Template.
  NOTE: This template CANNOT be packaged or signed on macOS.
  Requires Windows 10/11 x64 + Visual Studio 2022 (UWP C++ workload) + Windows SDK
  (makeappx.exe / signtool.exe), then sideload via Xbox Device Portal and reclassify
  from "App" to "Game" to unlock the ~5,120 MiB RAM cap and full D3D11/D3D12 support.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="ProjectXWine.Experimental"
    Publisher="CN=ProjectXWineDev"
    Version="0.2.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Project XWine (Experimental)</DisplayName>
    <PublisherDisplayName>Project XWine Contributors</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Xbox" MinVersion="10.0.22621.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="XWineApp" Executable="XWineLauncher.exe" EntryPoint="XWine.App">
      <uap:VisualElements
        DisplayName="XWine (Experimental)"
        Description="Experimental Windows compatibility research environment for Xbox Developer Mode."
        BackgroundColor="#080C15"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- Required ONLY for Phase 7 VirtualAllocFromApp / VirtualProtectFromApp W^X research in Dev Mode -->
    <Capability Name="codeGeneration" />
    <!-- External NTFS USB drive access requires ALL APPLICATION PACKAGES ACL on Windows -->
    <DeviceCapability Name="removableStorage" />
  </Capabilities>
</Package>
